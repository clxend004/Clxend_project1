# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets/keys.

# ================= BACKEND API =================
# "real" uses REACT_APP_REAL_API, anything else uses REACT_APP_MOCK_API
REACT_APP_API_TYPE=real
REACT_APP_REAL_API=http://127.0.0.1:8000
REACT_APP_MOCK_API=http://localhost:3000

# ================= FIREBASE (Google login) =================
# Get these from Firebase Console > Project Settings > General > Your apps > SDK setup and configuration
# Full setup steps: docs/GOOGLE_AUTH_SETUP.md
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# ================= BACKEND-ONLY (backend/.env, not this file) =================
# POST /auth/google needs the SAME Firebase project id as
# REACT_APP_FIREBASE_PROJECT_ID above, set as FIREBASE_PROJECT_ID
# in backend/.env (see docs/GOOGLE_AUTH_SETUP.md).